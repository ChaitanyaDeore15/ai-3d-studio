# =======================================================
# AI 3D STUDIO - CONFIGURATION ENVIRONMENT VARIABLES
# =======================================================

# Environment Mode: development / production
ENV=development
SECRET_KEY=super-secret-development-key-change-in-prod-xyz123456

# Database Connection (Default SQLite for instant local dev, or PostgreSQL for Production)
# DATABASE_URL=postgresql://ai3d_user:ai3d_password@localhost:5432/ai_3d_studio
DATABASE_URL=sqlite:///./ai_3d_studio.db

# Redis Connection URL
REDIS_URL=redis://localhost:6379/0

# Blender Executable Path (Headless background worker)
# Windows default:
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Linux default:
# BLENDER_PATH=/usr/local/bin/blender

BLENDER_TIMEOUT_SECONDS=60

# Asset Storage Service (local or s3)
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage_data

# S3 Compatible Object Storage Configuration (Optional)
# S3_BUCKET_NAME=my-ai-3d-assets-bucket
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1

# External AI 3D Providers (meshy, tripo, or none)
AI_3D_PROVIDER=meshy
MESHY_API_KEY=
TRIPO_API_KEY=

AI_PROVIDER_TIMEOUT_SECONDS=300
AI_MAX_CONCURRENT_JOBS=3

# Financial & Rate Limiting Controls
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_PROMPT_LENGTH=1000
DAILY_BUDGET_LIMIT_USD=25.00
